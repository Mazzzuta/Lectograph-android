# GigaChat is selected when its authorization key is set.
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional Gemini configuration.
# Use a project with a free quota; the server cannot inspect your Google billing settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=8787
HOST=127.0.0.1
# Match these application caps to the quotas shown for your project in AI Studio.
DAILY_REQUESTS=50
DAILY_TOKEN_BUDGET=500000
MINUTE_REQUESTS=3
MINUTE_TOKEN_BUDGET=250000
